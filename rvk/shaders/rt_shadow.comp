#version 460
#extension GL_EXT_ray_query : require
// RVK_RtShadow 1 (raytrace.cpp RenderRtShadow): the sun's shadows ray traced, from the depth pre-pass's depth before
// the scene is shaded (the scene shader takes the result where its fragment is the pre-pass's surface). Per pixel, one
// ray towards a point of the sun's disc (a new one each frame; the disc as wide as the shadow map's softness makes its
// penumbrae) into the ray tracing's casters - the static world, not the ground (instance mask 1: the ground casts no
// shadow of its own, as in the map). Averaged over frames: each pixel's history found where the camera saw its point
// last frame, dropped where the depth there disagrees. Out: visibility, view depth, and the mean distance to what the
// rays hit (rt_shadow_blur.comp widens its filter with it - a penumbra widens away from its caster).
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0) uniform accelerationStructureEXT tlas;
layout(set = 0, binding = 1) uniform sampler2D depthTex;
layout(set = 0, binding = 2) uniform sampler2D history;     // last frame's: visibility, view depth, frames, hit distance
layout(set = 0, binding = 3, rgba16f) uniform writeonly image2D outHistory;
layout(set = 0, binding = 4, rgba16f) uniform writeonly image2D outRaw;   // visibility, view depth, hit distance
layout(set = 0, binding = 5, std140) uniform Params {
    vec4 proj;          // D3D projection: m[2][2], m[3][2], m[0][0], m[1][1]
    vec4 size;          // width, height, the sun disc's radius (tan of its angle), this frame's noise offset (0..1)
    vec4 view[3];       // the view matrix's rotation, rows (world -> view); w: towards the sun, world x, y, z
    mat4 reproject;     // this frame's clip -> last frame's (raw D3DMATRIX memory)
    vec4 misc;          // x: 1 = the history is this camera's last frame, y: the rays' reach, z: frames averaged at most
} P;

// The view-space point at a pixel of depth d.
vec3 ViewPoint(vec2 pix, float d)
{
    float z = P.proj.y / (min(d, 0.999999) - P.proj.x);
    vec2 ndc = vec2(pix.x / P.size.x * 2.0 - 1.0, 1.0 - pix.y / P.size.y * 2.0);
    return vec3(ndc.x * z / P.proj.z, ndc.y * z / P.proj.w, z);
}

void main()
{
    ivec2 pix = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = ivec2(P.size.xy);
    if (pix.x >= size.x || pix.y >= size.y) return;
    float d = texelFetch(depthTex, pix, 0).r;
    if (d >= 1.0) {                              // the sky
        imageStore(outHistory, pix, vec4(1.0, 1e6, 0.0, 0.0));
        imageStore(outRaw, pix, vec4(1.0, 1e6, 0.0, 0.0));
        return;
    }
    vec3 v = ViewPoint(vec2(pix) + 0.5, d);
    // The surface's normal from the depth: of the two neighbours each way, the nearer in depth (not across an edge).
    vec3 l = ViewPoint(vec2(pix) + vec2(-0.5, 0.5), texelFetch(depthTex, clamp(pix - ivec2(1, 0), ivec2(0), size - 1), 0).r);
    vec3 r = ViewPoint(vec2(pix) + vec2(1.5, 0.5), texelFetch(depthTex, clamp(pix + ivec2(1, 0), ivec2(0), size - 1), 0).r);
    vec3 u = ViewPoint(vec2(pix) + vec2(0.5, -0.5), texelFetch(depthTex, clamp(pix - ivec2(0, 1), ivec2(0), size - 1), 0).r);
    vec3 b = ViewPoint(vec2(pix) + vec2(0.5, 1.5), texelFetch(depthTex, clamp(pix + ivec2(0, 1), ivec2(0), size - 1), 0).r);
    vec3 dx = abs(l.z - v.z) < abs(r.z - v.z) ? v - l : r - v;
    vec3 dy = abs(u.z - v.z) < abs(b.z - v.z) ? v - u : b - v;
    vec3 nv = cross(dy, dx);
    nv = dot(nv, nv) > 1e-12 ? normalize(nv) : vec3(0.0, 0.0, -1.0);
    if (dot(nv, v) > 0.0) nv = -nv;              // (towards the camera)
    // Camera-relative world (the structures are placed round the eye); the view's rotation transposed.
    vec3 p = vec3(dot(P.view[0].xyz, v), dot(P.view[1].xyz, v), dot(P.view[2].xyz, v));
    vec3 n = vec3(dot(P.view[0].xyz, nv), dot(P.view[1].xyz, nv), dot(P.view[2].xyz, nv));
    vec3 L = vec3(P.view[0].w, P.view[1].w, P.view[2].w);
    // A point of the sun's disc: interleaved gradient noise per pixel, moved on each frame (the averaging fills in).
    float ign = fract(52.9829189 * fract(dot(vec2(pix), vec2(0.06711056, 0.00583715))));
    float rr = sqrt(fract(ign + P.size.w)), a = 6.2831853 * fract(ign * 7.13 + P.size.w * 1.618034);
    vec3 t = normalize(abs(L.y) < 0.99 ? cross(L, vec3(0.0, 1.0, 0.0)) : cross(L, vec3(1.0, 0.0, 0.0)));
    vec3 dir = normalize(L + (t * cos(a) + cross(L, t) * sin(a)) * (rr * P.size.z));
    // Off the surface (more far off, where the depth's step is coarser), and a little towards the sun.
    vec3 origin = p + n * (0.03 + 0.002 * v.z) + dir * 0.02;
    float lit = 1.0, hit = 0.0;
    if (dot(n, L) > -0.05) {                     // (turned from the sun: the scene's light handles it)
        rayQueryEXT q;
        rayQueryInitializeEXT(q, tlas, gl_RayFlagsOpaqueEXT | gl_RayFlagsTerminateOnFirstHitEXT, 0x01, origin, 0.0, dir,
                              P.misc.y);
        while (rayQueryProceedEXT(q)) {}
        if (rayQueryGetIntersectionTypeEXT(q, true) == gl_RayQueryCommittedIntersectionTriangleEXT) {
            lit = 0.0;
            hit = rayQueryGetIntersectionTEXT(q, true);
        }
    }
    // Last frame's, where the camera saw this point then.
    float frames = 1.0, meanHit = hit, vis = lit;
    if (P.misc.x > 0.5) {
        vec2 ndc = vec2((float(pix.x) + 0.5) / P.size.x * 2.0 - 1.0, 1.0 - (float(pix.y) + 0.5) / P.size.y * 2.0);
        vec4 prev = P.reproject * vec4(ndc, d, 1.0);
        vec2 then = vec2((prev.x / prev.w + 1.0) * 0.5 * P.size.x, (1.0 - prev.y / prev.w) * 0.5 * P.size.y);
        if (prev.w > 0.0 && all(greaterThanEqual(then, vec2(0.0))) && all(lessThan(then, P.size.xy))) {
            vec4 h = texelFetch(history, ivec2(then), 0);
            float zThen = prev.w;                // (D3D: clip w is the view depth)
            if (abs(h.g - zThen) < 0.02 * zThen + 0.05) {
                frames = min(h.b + 1.0, P.misc.z);
                vis = mix(h.r, lit, 1.0 / frames);
                // (The hit distance: of the hits alone - a lit sample says nothing about it.)
                meanHit = lit < 0.5 ? (h.a > 0.0 ? mix(h.a, hit, 0.25) : hit) : h.a;
            }
        }
    }
    imageStore(outHistory, pix, vec4(vis, v.z, frames, meanHit));
    imageStore(outRaw, pix, vec4(vis, v.z, meanHit, frames));
}
