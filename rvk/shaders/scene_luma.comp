#version 450
// How bright the land shows (rvk/darkness.cpp MeasureSceneLuma; docs/darkness-plan.md): the HDR scene on a 64 x 48
// grid, the sky left out (its depth at the clear value), each sample through the exposure and the night's darkening
// as tonemap.frag has them, clipped at white; the log-average of what is left written for the CPU (read when this
// frame slot comes round again), which raises the exposure when the land shows darker than RVK_Darkness's floor.
layout(local_size_x = 16, local_size_y = 16) in;
layout(push_constant) uniform Params {
    vec4 info;          // xy: the scene's size, z: the depth's clear value (the sky), w: 1 the depth is readable
    vec4 tone;          // x: the exposure, y: the night's darkening (its strength x how much it is night)
} P;
layout(binding = 0) uniform sampler2D scene;
layout(binding = 1) uniform sampler2D sceneDepth;
layout(binding = 2) buffer Out { float logSum; float count; float pad[2]; } O;

shared float s_sum[256], s_n[256];

void main()
{
    uint i = gl_LocalInvocationIndex;
    float sum = 0.0, n = 0.0;
    for (uint k = 0u; k < 12u; ++k) {
        uvec2 cell = gl_LocalInvocationID.xy + uvec2(16u * (k % 4u), 16u * (k / 4u));
        ivec2 p = ivec2((vec2(cell) + 0.5) / vec2(64.0, 48.0) * P.info.xy);
        if (P.info.w > 0.5 && texelFetch(sceneDepth, p, 0).r >= P.info.z)
            continue;
        float l = dot(max(texelFetch(scene, p, 0).rgb, vec3(0.0)), vec3(0.3, 0.59, 0.11)) * P.tone.x;
        if (!(l < 1e20))                         // (a broken pixel: NaN or overflowed)
            continue;
        if (P.tone.y > 0.0)                      // (tonemap.frag main: the darks and middle tones down, the bright kept)
            l *= mix(exp2(-0.7 * P.tone.y), 1.0, smoothstep(0.25, 0.8, l));
        sum += log2(clamp(l, 1.0 / 1024.0, 1.0));
        n += 1.0;
    }
    s_sum[i] = sum;
    s_n[i] = n;
    barrier();
    for (uint m = 128u; m > 0u; m >>= 1u) {
        if (i < m) { s_sum[i] += s_sum[i + m]; s_n[i] += s_n[i + m]; }
        barrier();
    }
    if (i == 0u) {
        O.logSum = s_sum[0];
        O.count = s_n[0];
    }
}
