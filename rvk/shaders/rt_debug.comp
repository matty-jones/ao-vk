#version 460
#extension GL_EXT_ray_query : require
// RVK_RtDebug 1 (raytrace.cpp): what the ray tracing's acceleration structures hold - a ray from the camera through
// each pixel; what it hits coloured by its instance (and its triangles' edges darker), shaded by distance - red where
// it sees a triangle's back; black where it hits nothing. Laid over the scene: what is missing from the rays shows as
// the scene's surfaces left uncovered.
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0) uniform accelerationStructureEXT tlas;
layout(set = 0, binding = 1, rgba16f) uniform writeonly image2D outImage;
layout(push_constant) uniform Push {
    mat4 invViewProj;   // camera-relative (the eye at the origin; raw D3D matrix memory)
    vec4 size;          // width, height
} P;

vec3 Palette(uint i)
{
    i = (i ^ 61u) ^ (i >> 16);
    i *= 9u;
    i ^= i >> 4;
    i *= 0x27d4eb2du;
    i ^= i >> 15;
    return vec3(float(i & 255u), float((i >> 8) & 255u), float((i >> 16) & 255u)) / 255.0 * 0.7 + 0.3;
}

void main()
{
    ivec2 pix = ivec2(gl_GlobalInvocationID.xy);
    if (pix.x >= int(P.size.x) || pix.y >= int(P.size.y)) return;
    vec2 ndc = vec2((float(pix.x) + 0.5) / P.size.x * 2.0 - 1.0, 1.0 - (float(pix.y) + 0.5) / P.size.y * 2.0);
    vec4 far = P.invViewProj * vec4(ndc, 1.0, 1.0);
    vec3 dir = normalize(far.xyz / far.w);
    rayQueryEXT q;
    rayQueryInitializeEXT(q, tlas, gl_RayFlagsOpaqueEXT, 0xFF, vec3(0.0), 0.05, dir, 5000.0);
    while (rayQueryProceedEXT(q)) {}
    vec3 c = vec3(0.0);
    if (rayQueryGetIntersectionTypeEXT(q, true) == gl_RayQueryCommittedIntersectionTriangleEXT) {
        float t = rayQueryGetIntersectionTEXT(q, true);
        vec2 b = rayQueryGetIntersectionBarycentricsEXT(q, true);
        float edge = min(min(b.x, b.y), 1.0 - b.x - b.y);
        c = Palette(uint(rayQueryGetIntersectionInstanceCustomIndexEXT(q, true))) / (1.0 + t * 0.004);
        c *= edge < 0.015 ? 0.4 : 1.0;
        if (!rayQueryGetIntersectionFrontFaceEXT(q, true)) c = vec3(1.0, 0.0, 0.0) / (1.0 + t * 0.004);
    }
    imageStore(outImage, pix, vec4(c, 1.0));
}
