#version 460
#extension GL_EXT_ray_query : require
// RVK_AoMode 2 (raytrace.cpp): ray-traced ambient occlusion. Per pixel, two rays over the surface's hemisphere
// (cosine-weighted: the light a surface takes in comes mostly from in front of it) into the ray tracing's structures,
// out to a reach of a few units; a hit occludes by how near it is. Unlike the screen's AO it sees what the screen
// doesn't: the underside of a bridge, the inside of a doorway, a wall behind the camera. Averaged over frames (each
// pixel's history found where it was last frame, by the motion vectors; dropped where the depth there disagrees),
// then blurred (ao_blur.frag) for the tone mapping.
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0) uniform accelerationStructureEXT tlas;
layout(set = 0, binding = 1) uniform sampler2D depthTex;
layout(set = 0, binding = 2) uniform sampler2D surface;     // gbuffer.frag: world normal, roughness
layout(set = 0, binding = 3) uniform sampler2D motion;      // motion_fill.frag: pixels, now - then
layout(set = 0, binding = 4) uniform sampler2D history;     // last frame's: occlusion (raw), view depth, frames
layout(set = 0, binding = 5, rgba16f) uniform writeonly image2D outHistory;
layout(set = 0, binding = 6, rgba16f) uniform writeonly image2D outAo;   // for the tone mapping: factor, view depth
layout(push_constant) uniform Push {
    vec4 proj;          // D3D projection: m[2][2], m[3][2], m[0][0], m[1][1]
    vec4 size;          // width, height, reach (world units), strength
    vec4 view[3];       // the view matrix's rotation, rows (world -> view; its transpose takes view -> world)
    vec4 frame;         // x: this frame's noise offset, y: 1 = the history is this camera's last frame
} P;

const int kRays = 2;

void main()
{
    ivec2 pix = ivec2(gl_GlobalInvocationID.xy);
    if (pix.x >= int(P.size.x) || pix.y >= int(P.size.y)) return;
    float d = texelFetch(depthTex, pix, 0).r;
    if (d >= 1.0) {                              // the sky
        imageStore(outHistory, pix, vec4(1.0, 1e6, 0.0, 0.0));
        imageStore(outAo, pix, vec4(1.0, 1e6, 0.0, 0.0));
        return;
    }
    float z = P.proj.y / (min(d, 0.999999) - P.proj.x);
    vec2 ndc = vec2((float(pix.x) + 0.5) / P.size.x * 2.0 - 1.0, 1.0 - (float(pix.y) + 0.5) / P.size.y * 2.0);
    vec3 v = vec3(ndc.x * z / P.proj.z, ndc.y * z / P.proj.w, z);
    // Camera-relative world position (the structures are placed round the eye).
    vec3 p = vec3(dot(P.view[0].xyz, v), dot(P.view[1].xyz, v), dot(P.view[2].xyz, v));
    vec3 n = texelFetch(surface, pix, 0).xyz;
    n = dot(n, n) > 1e-6 ? normalize(n) : vec3(0.0, 1.0, 0.0);
    // A frame round the normal.
    vec3 t = normalize(abs(n.y) < 0.99 ? cross(n, vec3(0.0, 1.0, 0.0)) : cross(n, vec3(1.0, 0.0, 0.0)));
    vec3 b = cross(n, t);
    float reach = P.size.z;
    vec3 origin = p + n * (0.02 + 0.0015 * z);
    // Interleaved gradient noise per pixel, moved on each frame (golden ratio) - the accumulation fills in the rest.
    float ign = fract(52.9829189 * fract(dot(vec2(pix), vec2(0.06711056, 0.00583715))));
    float occlusion = 0.0;
    for (int i = 0; i < kRays; ++i) {
        float u1 = fract(ign + P.frame.x + float(i) * 0.5);
        float u2 = fract(ign * 7.13 + P.frame.x * 1.618034 + float(i) * 0.37);
        float r = sqrt(u1), a = 6.2831853 * u2;
        vec3 dir = normalize(t * (r * cos(a)) + b * (r * sin(a)) + n * sqrt(max(1.0 - u1, 0.0)));
        // A surface seen from behind first: the ray started under it - the native ground near the camera is drawn
        // tessellated and displaced (up to a unit), its traced copy flat - so that one is passed through.
        float from = 0.0;
        for (int k = 0; k < 3; ++k) {
            rayQueryEXT q;
            rayQueryInitializeEXT(q, tlas, gl_RayFlagsOpaqueEXT, 0xFF, origin, from, dir, reach);
            while (rayQueryProceedEXT(q)) {}
            if (rayQueryGetIntersectionTypeEXT(q, true) != gl_RayQueryCommittedIntersectionTriangleEXT)
                break;
            float hit = rayQueryGetIntersectionTEXT(q, true);
            if (!rayQueryGetIntersectionFrontFaceEXT(q, true) && k < 2) {
                from = hit + 0.01;
                continue;
            }
            float h = hit / reach;
            occlusion += 1.0 - h * h;
            break;
        }
    }
    float open = 1.0 - occlusion / float(kRays);
    // Last frame's, where this point was then.
    vec2 then = vec2(pix) + 0.5 - texelFetch(motion, pix, 0).xy;
    float frames = 1.0;
    if (P.frame.y > 0.5 && all(greaterThanEqual(then, vec2(0.0))) && all(lessThan(then, P.size.xy))) {
        vec4 h = texelFetch(history, ivec2(then), 0);
        if (abs(h.g - z) < 0.04 * z + 0.05) {
            frames = min(h.b + 1.0, 16.0);
            open = mix(h.r, open, 1.0 / frames);
        }
    }
    imageStore(outHistory, pix, vec4(open, z, frames, 0.0));
    imageStore(outAo, pix, vec4(clamp(1.0 - P.size.w * (1.0 - open), 0.0, 1.0), z, 0.0, 0.0));
}
